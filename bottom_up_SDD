#include <iostream>
#include <stack>
#include <sstream>
#include <cmath>
#include <cctype>
#include <map>
#include <vector>

using namespace std;

// Function to return precedence of operators
int precedence(char op) {
    if (op == '^') return 3;
    if (op == '*' || op == '/') return 2;
    if (op == '+' || op == '-') return 1;
    return 0;
}

// Function to convert infix to postfix (Shunting Yard Algorithm)
vector<string> infixToPostfix(const string& expr) {
    vector<string> output;
    stack<char> operators;
    string number;

    for (size_t i = 0; i < expr.size(); ++i) {
        char ch = expr[i];

        if (isspace(ch)) continue;

        if (isdigit(ch) || ch == '.') {
            number += ch;
        } else {
            if (!number.empty()) {
                output.push_back(number);
                number.clear();
            }

            if (ch == '(') {
                operators.push(ch);
            } else if (ch == ')') {
                while (!operators.empty() && operators.top() != '(') {
                    output.push_back(string(1, operators.top()));
                    operators.pop();
                }
                if (!operators.empty()) operators.pop(); // pop '('
                else throw runtime_error("Invalid expression: mismatched parentheses");
            } else { // operator
                while (!operators.empty() && precedence(operators.top()) >= precedence(ch) && ch != '^') {
                    output.push_back(string(1, operators.top()));
                    operators.pop();
                }
                operators.push(ch);
            }
        }
    }

    if (!number.empty()) output.push_back(number);

    while (!operators.empty()) {
        if (operators.top() == '(') throw runtime_error("Invalid expression: mismatched parentheses");
        output.push_back(string(1, operators.top()));
        operators.pop();
    }

    return output;
}

// Function to evaluate postfix expression
double evaluatePostfix(const vector<string>& postfix) {
    stack<double> values;

    for (const string& token : postfix) {
        if (isdigit(token[0]) || (token.size() > 1 && token[0] == '-')) {
            values.push(stod(token));
        } else {
            if (values.size() < 2) throw runtime_error("Invalid expression: insufficient operands");
            double b = values.top(); values.pop();
            double a = values.top(); values.pop();
            if (token == "+") values.push(a + b);
            else if (token == "-") values.push(a - b);
            else if (token == "*") values.push(a * b);
            else if (token == "/") {
                if (b == 0) throw runtime_error("Division by zero");
                values.push(a / b);
            }
            else if (token == "^") values.push(pow(a, b));
        }
    }

    if (values.size() != 1) throw runtime_error("Invalid expression");
    return values.top();
}

int main() {
    string expr;
    cout << "Enter arithmetic expression: ";
    getline(cin, expr);

    try {
        auto postfix = infixToPostfix(expr);
        double result = evaluatePostfix(postfix);
        cout << "Result: " << result << endl;
    } catch (const exception& e) {
        cout << e.what() << endl;
    }

    return 0;
}
